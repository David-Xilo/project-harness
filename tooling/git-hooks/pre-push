#!/usr/bin/env bash
# git pre-push hook: runs leak-check on the commits each pushed ref sends; a hit, or a check
# that cannot run, stops the push. tooling/install links it into this repository.
set -uo pipefail
here=$(dirname "$(readlink -f "$0")")
remote=$1
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a delete sends nothing
  # A new ref, or one whose remote tip is not here: what no ref of the remote has.
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range=("$local_sha" --not --remotes="$remote")
  else
    range=("$remote_sha..$local_sha")
  fi
  "$here/../bin/leak-check" "${range[@]}" </dev/null || status=1
done
[ $status = 0 ] || echo "pre-push: leak-check stopped the push; fix the commits, then push again." >&2
exit $status
