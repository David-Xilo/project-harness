#!/usr/bin/env bash
# usage: sp-update [--ref <tag|branch|commit>] [--global] [--force] [--no-fetch] [root ...]
# Brings roots up to a version of project-harness: --ref, or else the newest main
# (origin/main after a fetch, when there is a remote). The version is unpacked once into
# ${XDG_DATA_HOME:-~/.local/share}/super-project/versions/<commit>/, and its sp-claude-init
# runs on each root (no roots: every one in `sp-config ROOTS`), updating the skills and Zed
# settings it placed there. --force replaces copies edited in a root. --global also runs
# that version's install, so the mods, hooks, commands and scripts run from it.
# Changes to the template docs since a root's last version are listed and their diff saved,
# to merge by hand. Nothing is committed.
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
config="$here/sp-config"
data="${XDG_DATA_HOME:-$HOME/.local/share}/super-project"
ref=""; global=0; force=(); fetch=1; roots=()
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) [ $# -ge 2 ] || { echo "--ref needs a tag, branch or commit"; exit 2; }; ref=$2; shift ;;
    --global) global=1 ;;
    --force) force=(--force) ;;
    --no-fetch) fetch=0 ;;
    -h|--help) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 0 ;;
    -*) echo "unknown option $1"; exit 2 ;;
    *) roots+=("$(realpath "$1")") ;;
  esac; shift
done

# The checkout: this script's own, or the one an unpacked version came from.
if [ -f "$here/../../.source" ]; then
  repo=$(awk '$1 == "repo" { print $2 }' "$here/../../.source")
else
  repo=$(git -C "$here" rev-parse --show-toplevel)
fi
git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || { echo "no project-harness checkout at $repo"; exit 1; }
remote=0
git -C "$repo" remote get-url origin >/dev/null 2>&1 && remote=1
if [ $remote = 1 ] && [ $fetch = 1 ]; then
  git -C "$repo" fetch --quiet --tags origin || echo "!! fetch failed; using what $repo has"
fi
[ -n "$ref" ] || { [ $remote = 1 ] && ref=origin/main || ref=main; }
commit=$(git -C "$repo" rev-parse --verify --quiet "$ref^{commit}") || { echo "no such ref in $repo: $ref"; exit 1; }
version=$(git -C "$repo" describe --tags --always "$commit")

# Unpack the version once; a finished folder is never changed.
snap="$data/versions/$commit"
if [ ! -d "$snap" ]; then
  mkdir -p "$data/versions"
  tmp=$(mktemp -d "$data/versions/.unpack.XXXXXX")
  git -C "$repo" archive "$commit" | tar -x -C "$tmp"
  printf 'repo %s\ncommit %s\nversion %s\n' "$repo" "$commit" "$version" > "$tmp/.source"
  mv "$tmp" "$snap"
fi
[ -x "$snap/tooling/bin/sp-claude-init" ] || { echo "$version has no tooling/bin/sp-claude-init: too old for sp-update"; exit 1; }
echo "project-harness $version ($snap)"

if [ $global = 1 ]; then
  echo "== global tools"
  [ -x "$snap/tooling/install" ] || { echo "$version has no tooling/install: too old for --global"; exit 1; }
  "$snap/tooling/install"
fi

if [ ${#roots[@]} -eq 0 ]; then
  list=$("$config" ROOTS)
  [ -f "$list" ] && while IFS= read -r r; do
    [[ -z $r || $r == \#* ]] && continue
    [ -d "$r" ] && roots+=("$r") || echo "!! listed in $list but missing: $r"
  done < "$list"
fi
[ ${#roots[@]} -gt 0 ] || { echo "No roots: pass them or register them with sp-claude-init."; exit 1; }

for root in "${roots[@]}"; do
  # The newer lock: project-harness.lock, or project-template.lock from before the rename
  # (or written since by an older version's sp-claude-init).
  lock="$root/.claude/project-harness.lock"
  [ -f "$root/.claude/project-template.lock" ] && { [ ! -f "$lock" ] || [ "$root/.claude/project-template.lock" -nt "$lock" ]; } \
    && lock="$root/.claude/project-template.lock"
  old=$(awk '$1 == "commit" { print $2 }' "$lock" 2>/dev/null || true)
  "$snap/tooling/bin/sp-claude-init" "$root" "${force[@]}"
  # The template docs were filled in by hand, so their changes are merged by hand.
  if [ -n "$old" ] && [ "$old" != unknown ] && [ "$old" != "$commit" ]; then
    if git -C "$repo" cat-file -e "$old^{commit}" 2>/dev/null; then
      stat=$(git -C "$repo" diff --stat "$old" "$commit" -- workspace module)
      if [ -n "$stat" ]; then
        diff="$data/upgrades/$(basename "$root")-${old:0:7}-${commit:0:7}.diff"
        mkdir -p "$(dirname "$diff")"
        git -C "$repo" diff "$old" "$commit" -- workspace module > "$diff"
        echo "Template docs changed since ${old:0:7}; merge what applies into the root's docs by hand:"
        echo "$stat"
        echo "diff: $diff"
      fi
    else
      echo "!! ${old:0:7}, this root's last version, is not in $repo: compare the docs by hand"
    fi
  fi
done

# Where the global tools run from: the version just used, a checkout, or another version.
live=$(readlink -f "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/mods/workspace" 2>/dev/null || true)
case "$live" in
  "$snap"/*) ;;
  "$data/versions/"*) other=${live#"$data/versions/"}; echo "Global tools run from another version (${other%%/*}); --global switches them." ;;
  "") echo "Global tools are not installed; --global installs them." ;;
  *) echo "Global tools run from ${live%/tooling/*}; --global switches them to $version." ;;
esac
