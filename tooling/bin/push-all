#!/usr/bin/env bash
set -uo pipefail
root="${1:?usage: push-all <root>}"; cd "$root" || exit 1
top=$(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | awk '{print $2}')
mods=$(for t in $top; do  # nested submodules first, deepest first, then their parent
  [ -d "$t" ] && git -C "$t" submodule foreach --recursive --quiet 'echo "$displaypath"' 2>/dev/null | tac | sed "s|^|$t/|"
  echo "$t"; done)
push_repo() {
  local ahead; ahead=$(git -C "$1" rev-list --count '@{u}..HEAD' 2>/dev/null || echo "?")
  [ "$ahead" = 0 ] && return
  echo "== $2 (ahead: $ahead)"
  git -C "$1" push || echo "!! push failed: $2"
}
for m in $mods; do push_repo "$m" "$m"; done   # modules first
push_repo . "$(basename "$PWD") (root)"        # root last, so its pointers exist on the remote
echo; echo "Done. Press Enter to close."; read -r
