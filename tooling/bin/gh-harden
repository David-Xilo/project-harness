#!/usr/bin/env bash
# usage: gh-harden <owner/repo> [--apply] [--main <b>] [--dev <b>] [--check-name <name>]
# Reads every GitHub setting a public repository needs through gh api and prints one
# line each: ok, missing (with the command that sets it), after public, waiting (for
# what), or ui (set by hand, not readable here). --apply sets the missing items, then reads
# them all again. It never changes visibility, and never the operator's account items.
# Rulesets come from tooling/publish/rulesets/*.json, matched by name: one that exists is
# updated, not added again. --main (main), --dev (development) and --check-name (Checks)
# name the protected branches and the CI check that main requires.
# Exits 1 when an item is missing, 2 when one cannot be read.
set -uo pipefail
here=$(dirname "$(readlink -f "$0")")
rulesets="$here/../publish/rulesets"
repo='' apply=0 main=main dev=development check=Checks
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 0 ;;
    --apply) apply=1; shift ;;
    --main | --dev | --check-name)
      [ $# -ge 2 ] || { echo "gh-harden: $1 needs a value" >&2; exit 2; }
      case "$1" in --main) main=$2 ;; --dev) dev=$2 ;; *) check=$2 ;; esac
      shift 2 ;;
    -*) echo "gh-harden: unknown option $1" >&2; exit 2 ;;
    *) [ -z "$repo" ] || { echo "gh-harden: one repository at a time" >&2; exit 2; }; repo=$1; shift ;;
  esac
done
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { sed -n '2s/^# //p' "$0" >&2; exit 2; }
command -v gh >/dev/null || { echo "gh-harden: gh is not installed" >&2; exit 2; }
command -v jq >/dev/null || { echo "gh-harden: jq is not installed" >&2; exit 2; }
R="repos/$repo"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

# get <path>: the body on stdout. Returns 0, 4 on a 404, or 2 with the error in $tmp/err.
# Each path is read once per pass.
get() {
  local key="$tmp/cache/${1//[^A-Za-z0-9_.-]/_}"
  mkdir -p "$tmp/cache"
  if [ ! -e "$key.code" ]; then
    gh api -H "X-GitHub-Api-Version: 2022-11-28" "$1" >"$key" 2>"$key.err" </dev/null
    case $? in
      0) echo 0 ;;
      *) if grep -q '(HTTP 404)' "$key.err"; then echo 4; else echo 2; fi ;;
    esac >"$key.code"
  fi
  cp "$key.err" "$tmp/err"
  cat "$key"
  return "$(cat "$key.code")"
}
# send <method> <path> [<body>]: a write, as --apply runs it.
send() {
  if [ $# -ge 3 ]; then
    gh api -H "X-GitHub-Api-Version: 2022-11-28" -X "$1" "$2" --input - <<<"$3"
  else
    gh api -H "X-GitHub-Api-Version: 2022-11-28" -X "$1" "$2" </dev/null
  fi
}
# The same write, as a command to copy.
shown() { if [ $# -ge 3 ]; then printf "gh api -X %s %s --input - <<<'%s'" "$1" "$2" "$3"; else printf 'gh api -X %s %s' "$1" "$2"; fi; }
err() { sed -n '1{s/^gh: //;p}' "$tmp/err"; }

# Each item sets: st (ok, missing, after, waiting, ui, unknown), say, and fixes: the writes
# that set it, one per line, as method TAB path [TAB body]. operator=1: --apply leaves it.
items=(signing vigilant twofa features merges actions token forks reporting alerts updates
  immutable secrets codeql rs_main rs_dev rs_tags)
declare -A label=(
  [signing]="signing key" [vigilant]="vigilant mode" [twofa]="two-factor"
  [features]="features" [merges]="merges" [actions]="actions" [token]="workflow token"
  [forks]="fork approval" [reporting]="vuln reporting" [alerts]="dependabot alerts"
  [updates]="security updates" [immutable]="immutable releases" [secrets]="secret scanning"
  [codeql]="code scanning" [rs_main]="ruleset main" [rs_dev]="ruleset development"
  [rs_tags]="ruleset release-tags")
fix() { fixes+="$(printf '%s\t' "$@" | sed 's/\t$//')"$'\n'; }
public=0

is_public() { [ $public = 1 ] || { st=after say="free once the repository is public"; return 1; }; }
want() { # <json> <jq test>: ok when the test holds
  if jq -e "$2" >/dev/null <<<"$1"; then st=ok; else st=missing; fi
}
on_off() { jq -r "$1" <<<"$2"; }

read_signing() {
  operator=1
  local b c
  b=$(get "$R" | jq -r .default_branch)
  c=$(get "$R/commits/$b") || { st=unknown say="$(err)"; return; }
  case "$(jq -r '.commit.verification | if .verified then "verified" else .reason end' <<<"$c")" in
    verified) st=ok say="the newest commit on $b is verified" ;;
    unknown_key) st=missing say="GitHub does not know the key that signed the newest commit on $b. Add it: gh ssh-key add <key>.pub --type signing --title <name> (needs gh auth refresh -s admin:ssh_signing_key)" ;;
    unsigned) st=missing say="the newest commit on $b is not signed; sign commits, then push one" ;;
    *) st=missing say="the newest commit on $b is not verified ($(jq -r .commit.verification.reason <<<"$c"))" ;;
  esac
}
read_vigilant() { st=ui say="Settings → SSH and GPG keys → Flag unsigned commits as unverified"; }
read_twofa() { st=ui say="Settings → Password and authentication"; }
read_features() {
  local r; r=$(get "$R") || { st=unknown say="$(err)"; return; }
  want "$r" '.has_wiki == false and .has_projects == false and .has_issues == true'
  say=$(jq -r '"wiki \(if .has_wiki then "on" else "off" end), projects \(if .has_projects then "on" else "off" end), issues \(if .has_issues then "on" else "off" end)"' <<<"$r")
  fix PATCH "$R" '{"has_wiki":false,"has_projects":false,"has_issues":true}'
}
read_merges() {
  local r; r=$(get "$R") || { st=unknown say="$(err)"; return; }
  want "$r" '.allow_merge_commit == true and .allow_squash_merge == true and .allow_rebase_merge == false and .delete_branch_on_merge == true'
  say=$(jq -r '[(if .allow_merge_commit then "merge" else empty end), (if .allow_squash_merge then "squash" else empty end), (if .allow_rebase_merge then "rebase" else empty end)] as $m
    | "merges: \(if $m == [] then "none" else $m | join(", ") end); head branches \(if .delete_branch_on_merge then "" else "not " end)deleted"' <<<"$r")
  fix PATCH "$R" '{"allow_merge_commit":true,"allow_squash_merge":true,"allow_rebase_merge":false,"delete_branch_on_merge":true}'
}
read_actions() {
  local p s patterns='[]'
  p=$(get "$R/actions/permissions") || { st=unknown say="$(err)"; return; }
  if jq -e '.allowed_actions == "selected"' >/dev/null <<<"$p"; then
    s=$(get "$R/actions/permissions/selected-actions") || { st=unknown say="$(err)"; return; }
    patterns=$(jq -c '.patterns_allowed // []' <<<"$s")
  else
    s='{}'
  fi
  if jq -e '.enabled == true and .allowed_actions == "selected" and .sha_pinning_required == true' >/dev/null <<<"$p" \
    && jq -e '.github_owned_allowed == true and .verified_allowed == false' >/dev/null <<<"$s"; then
    st=ok
  else
    st=missing
  fi
  say="allowed: $(jq -r '.allowed_actions // "none"' <<<"$p")$(jq -r 'if .sha_pinning_required then ", SHA pinning required" else ", SHA pinning not required" end' <<<"$p")"
  [ "$patterns" != '[]' ] && say+=", patterns: $(jq -r 'join(", ")' <<<"$patterns")"
  fix PUT "$R/actions/permissions" '{"enabled":true,"allowed_actions":"selected","sha_pinning_required":true}'
  fix PUT "$R/actions/permissions/selected-actions" "{\"github_owned_allowed\":true,\"verified_allowed\":false,\"patterns_allowed\":$patterns}"
}
read_token() {
  local r; r=$(get "$R/actions/permissions/workflow") || { st=unknown say="$(err)"; return; }
  want "$r" '.default_workflow_permissions == "read" and .can_approve_pull_request_reviews == false'
  say=$(jq -r '"\(.default_workflow_permissions); Actions \(if .can_approve_pull_request_reviews then "can" else "cannot" end) approve pull requests"' <<<"$r")
  fix PUT "$R/actions/permissions/workflow" '{"default_workflow_permissions":"read","can_approve_pull_request_reviews":false}'
}
read_forks() {
  local r; r=$(get "$R/actions/permissions/fork-pr-contributor-approval") || { st=unknown say="$(err)"; return; }
  want "$r" '.approval_policy == "all_external_contributors"'
  say=$(jq -r '.approval_policy' <<<"$r")
  fix PUT "$R/actions/permissions/fork-pr-contributor-approval" '{"approval_policy":"all_external_contributors"}'
}
enabled() { # <item path>: GET answers {"enabled": …}; a 404 is off
  local r c
  r=$(get "$1"); c=$?
  case $c in
    0) want "$r" '.enabled == true'; say=$(jq -r 'if .enabled then "on" else "off" end' <<<"$r") ;;
    4) st=missing say=off ;;
    *) st=unknown say="$(err)"; return ;;
  esac
  fix PUT "$1"
}
read_reporting() { enabled "$R/private-vulnerability-reporting"; }
read_alerts() {
  get "$R/vulnerability-alerts" >/dev/null
  case $? in
    0) st=ok say=on ;;
    4) st=missing say=off ;;
    *) st=unknown say="$(err)"; return ;;
  esac
  fix PUT "$R/vulnerability-alerts"
}
read_updates() { enabled "$R/automated-security-fixes"; }
read_immutable() { enabled "$R/immutable-releases"; }
read_secrets() {
  is_public || return
  local r; r=$(get "$R") || { st=unknown say="$(err)"; return; }
  want "$r" '.security_and_analysis.secret_scanning.status == "enabled" and .security_and_analysis.secret_scanning_push_protection.status == "enabled"'
  say=$(jq -r '.security_and_analysis | "scanning \(.secret_scanning.status // "unknown"), push protection \(.secret_scanning_push_protection.status // "unknown")"' <<<"$r")
  fix PATCH "$R" '{"security_and_analysis":{"secret_scanning":{"status":"enabled"},"secret_scanning_push_protection":{"status":"enabled"}}}'
}
read_codeql() {
  is_public || return
  local r; r=$(get "$R/code-scanning/default-setup") || { st=unknown say="$(err)"; return; }
  want "$r" '.state == "configured"'
  say="CodeQL default setup: $(jq -r '.state' <<<"$r")"
  fix PATCH "$R/code-scanning/default-setup" '{"state":"configured","query_suite":"default"}'
}
# The ruleset as it should be: the file, with this repository's branches and check.
body() {
  jq -c --arg main "$main" --arg dev "$dev" --arg check "$check" '
    if .name == "main" then .conditions.ref_name.include = ["refs/heads/" + $main]
      | (.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks) = [{context: $check}]
    elif .name == "development" then .conditions.ref_name.include = ["refs/heads/" + $dev]
    else . end' "$rulesets/$1.json"
}
ruleset() { # <file name> [<branch>] [<check that must have passed on it>]
  is_public || return
  local w id have
  w=$(body "$1")
  if [ -n "${2:-}" ]; then
    get "$R/branches/$2" >/dev/null
    case $? in
      0) ;;
      4) st=waiting say="no branch $2 yet"; return ;;
      *) st=unknown say="$(err)"; return ;;
    esac
  fi
  if [ "${sts[signing]:-}" != ok ] && jq -e 'any(.rules[]; .type == "required_signatures")' >/dev/null <<<"$w"; then
    st=waiting say="the signing key first: required signatures would refuse the pushes"; return
  fi
  if [ -n "${3:-}" ]; then
    local runs
    runs=$(get "$R/commits/$2/check-runs?check_name=$3") || { st=unknown say="$(err)"; return; }
    if ! jq -e 'any(.check_runs[]?; .conclusion == "success")' >/dev/null <<<"$runs"; then
      st=waiting say="CI ($3) has not passed on $2"; return
    fi
  fi
  local list; list=$(get "$R/rulesets?includes_parents=false") || { st=unknown say="$(err)"; return; }
  id=$(jq -r --arg n "$1" 'map(select(.name == $n)) | first | .id // empty' <<<"$list")
  if [ -z "$id" ]; then
    st=missing say="not there"
    fix POST "$R/rulesets" "$w"
    return
  fi
  have=$(get "$R/rulesets/$id") || { st=unknown say="$(err)"; return; }
  # What differs from the file, one phrase each; none means ok.
  local diff
  diff=$(jq -r --argjson w "$w" '
    (if .enforcement != $w.enforcement then "enforcement \(.enforcement)" else empty end),
    (if .target != $w.target then "target \(.target)" else empty end),
    ((.bypass_actors // []) | if length > 0 then "\(length) bypass actors" else empty end),
    (if .conditions.ref_name.include != $w.conditions.ref_name.include
      then "applies to \(.conditions.ref_name.include | join(" "))" else empty end),
    (. as $h | $w.rules[] | . as $r | [$h.rules[]? | select(.type == $r.type)]
      | if length == 0 then "no \($r.type) rule"
        elif any(.[]; (.parameters // {}) | contains($r.parameters // {})) then empty
        else "\($r.type) parameters differ" end)' <<<"$have" | paste -sd, | sed 's/,/, /g')
  if [ -z "$diff" ]; then
    st=ok say="$(jq -r '[.rules[].type] | join(", ")' <<<"$have")"
  else
    st=missing say="differs from tooling/publish/rulesets/$1.json: $diff"
    fix PUT "$R/rulesets/$id" "$w"
  fi
}
read_rs_main() { ruleset main "$main" "$check"; }
read_rs_dev() { ruleset development "$dev"; }
read_rs_tags() { ruleset release-tags; }

declare -A sts says fixs ops
read_all() {
  rm -rf "$tmp/cache"
  local r i
  r=$(get "$R") || { echo "gh-harden: cannot read $repo: $(err)" >&2; exit 2; }
  public=$([ "$(jq -r .visibility <<<"$r")" = public ] && echo 1 || echo 0)
  visibility=$(jq -r .visibility <<<"$r")
  for i in "${items[@]}"; do
    st='' say='' fixes='' operator=0
    "read_$i"
    sts[$i]=$st says[$i]=$say fixs[$i]=$fixes ops[$i]=$operator
  done
}

read_all
if [ $apply = 1 ]; then
  for i in "${items[@]}"; do
    [ "${sts[$i]}" = missing ] || continue
    if [ "${ops[$i]}" = 1 ] || [ -z "${fixs[$i]}" ]; then
      echo "leave  ${label[$i]}: the operator sets it"
      continue
    fi
    while IFS=$'\t' read -r -a f; do
      [ ${#f[@]} -gt 0 ] || continue
      if send "${f[@]}" >/dev/null 2>"$tmp/err"; then
        echo "set    ${label[$i]}: ${f[0]} ${f[1]}"
      else
        echo "failed ${label[$i]}: ${f[0]} ${f[1]}: $(err)"
        break
      fi
    done <<<"${fixs[$i]}"
  done
  echo
  read_all
fi

echo "gh-harden: $repo, $visibility"
declare -A count
for i in "${items[@]}"; do
  s=${sts[$i]}
  count[$s]=$((${count[$s]:-0} + 1))
  word=$s
  case $s in after) word="after public" ;; unknown) word=FAIL ;; esac
  printf '%-12s %-19s %s\n' "$word" "${label[$i]}" "${says[$i]}"
  if [ "$s" = missing ] && [ "${ops[$i]}" = 0 ]; then
    while IFS=$'\t' read -r -a f; do
      [ ${#f[@]} -gt 0 ] && printf '%33s %s\n' '' "$(shown "${f[@]}")"
    done <<<"${fixs[$i]}"
  fi
done
summary=()
[ "${count[missing]:-0}" -gt 0 ] && summary+=("${count[missing]} missing")
[ "${count[unknown]:-0}" -gt 0 ] && summary+=("${count[unknown]} cannot be read")
[ "${count[after]:-0}" -gt 0 ] && summary+=("${count[after]} after public")
[ "${count[waiting]:-0}" -gt 0 ] && summary+=("${count[waiting]} waiting")
if [ ${#summary[@]} -eq 0 ]; then
  echo "gh-harden: every item is set; check the ui items by hand"
else
  echo "gh-harden: $(printf '%s\n' "${summary[@]}" | paste -sd, | sed 's/,/, /g')"
fi
[ "${count[unknown]:-0}" -gt 0 ] && exit 2
[ "${count[missing]:-0}" -gt 0 ] && exit 1
exit 0
