#!/usr/bin/env bash
# usage: leak-check                 the tracked files as they are in the working tree
#        leak-check <revisions>...  the commits git rev-list gives for them ("old..new"):
#                                   every file each one changes, and its message
#        leak-check --history       every commit reachable from HEAD
# Runs gitleaks and the private-strings denylist (sp-config PRIVATE_STRINGS: one string per
# line, matched in any case; blank lines and lines starting with # are skipped) on the
# current repository. Prints file names and counts of matching lines only, never what
# matched. Exits 1 on a hit, 2 when it cannot check. The pre-push hook runs it on the
# commits a push sends.
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
case "${1:-}" in
  -h | --help) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 0 ;;
  --history) set -- HEAD ;;
esac
command -v gitleaks >/dev/null || { echo "leak-check: gitleaks is not installed" >&2; exit 2; }
top=$(git rev-parse --show-toplevel) || exit 2
cd "$top"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

denylist=$("$here/sp-config" PRIVATE_STRINGS)
list="$tmp/denylist"
if [ -f "$denylist" ]; then
  tr -d '\r' <"$denylist" | grep -v -e '^[[:space:]]*$' -e '^#' >"$list" || true
else
  echo "leak-check: no denylist at $denylist; gitleaks only" >&2
fi
[ -s "$list" ] || list=

# Hits, one per line: <source> TAB <count> TAB <where>.
hits="$tmp/hits"
: >"$hits"
gitleaks_hits() { # $1: report, $2: a prefix to strip from file names
  jq -r --arg p "$2" 'group_by(.Commit[0:7] + .File + .RuleID)[]
    | ["gitleaks", length, ((.[0].Commit[0:7] | if . == "" then "" else . + ": " end)
        + (.[0].File | ltrimstr($p)) + " (" + .[0].RuleID + ")")] | @tsv' "$1" >>"$hits"
}
flags=(--no-banner --redact --log-level error --exit-code 0 --report-format json --report-path "$tmp/gitleaks.json")

if [ $# -eq 0 ]; then
  what="the tracked files"
  if [ -n "$list" ]; then
    git grep -c -I -F -i -f "$list" | awk -F: -v OFS='\t' '{ n = $NF; sub(/:[0-9]+$/, ""); print "denylist", n, $0 }' >>"$hits" || true
  fi
  # gitleaks reads a folder, so it gets a copy of the tracked files only.
  mkdir "$tmp/tree"
  git ls-files -z | tar --null --no-recursion --ignore-failed-read -T - -cf - 2>/dev/null | tar -x -C "$tmp/tree"
  gitleaks dir "${flags[@]}" -i "$top" "$tmp/tree" || exit 2
  gitleaks_hits "$tmp/gitleaks.json" "$tmp/tree/"
else
  commits=$(git rev-list "$@") || exit 2
  what="$(printf '%s\n' "$commits" | grep -c . || true) commits"
  if [ -n "$commits" ]; then
    if [ -n "$list" ]; then
      for c in $commits; do
        short=$(git rev-parse --short=7 "$c")
        mapfile -d '' changed < <(git diff-tree -m -r --root --no-commit-id --name-only -z "$c")
        if [ ${#changed[@]} -gt 0 ]; then
          git --literal-pathspecs grep -c -I -F -i -f "$list" "$c" -- "${changed[@]}" \
            | awk -F: -v OFS='\t' -v c="$short" '{ n = $NF; sub(/:[0-9]+$/, ""); sub(/^[^:]+:/, ""); print "denylist", n, c ": " $0 }' >>"$hits" || true
        fi
        n=$(git log -1 --format=%B "$c" | grep -c -i -F -f "$list" || true)
        [ "$n" -gt 0 ] && printf 'denylist\t%s\t%s: message\n' "$n" "$short" >>"$hits"
      done
    fi
    gitleaks git "${flags[@]}" -i "$top" --log-opts "$*" "$top" || exit 2
    gitleaks_hits "$tmp/gitleaks.json" ""
  fi
fi

if [ ! -s "$hits" ]; then
  echo "leak-check: no hits in $what"
  exit 0
fi
sort -u "$hits" | sort -t "$(printf '\t')" -k1,1 -k3,3 -o "$hits"
echo "leak-check: $(awk -F'\t' '{ s += $2 } END { print s }' "$hits") hits in $what"
awk -F'\t' '{ printf "  %-9s %4s  %s\n", $1, $2, $3 }' "$hits"
exit 1
