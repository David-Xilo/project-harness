#!/usr/bin/env bash
# usage: tooling/install           link the tooling into place, backing up what it replaces
#        tooling/install --check   say what is linked and what is not; change nothing
#        tooling/install [--check] --hook <repo>...   only the pre-push hook, into those repositories
# Links each file (each mod or skill folder) to the path the tools are called by, so the repository is
# the running copy. A file already there that is not the link moves to
# ${XDG_STATE_HOME:-~/.local/state}/super-project/backup/<time>/. Running it again changes
# nothing. settings.json is never edited: the hooks and plugin dirs it needs are printed.
set -euo pipefail
repo=$(dirname "$(readlink -f "$0")")
config="$repo/bin/sp-config"
claude="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
backup="${XDG_STATE_HOME:-$HOME/.local/state}/super-project/backup/$(date +%Y%m%d-%H%M%S)"
check=0 hook=0 repos=()
while [ $# -gt 0 ]; do
  case "$1" in
    --check) check=1 ;;
    --hook) hook=1 ;;
    -*) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 2 ;;
    *) [ $hook = 1 ] || { sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 2; }; repos+=("$1") ;;
  esac
  shift
done
[ $hook = 0 ] || [ ${#repos[@]} -gt 0 ] || { echo "--hook needs a repository"; exit 2; }
bin=$("$config" BIN_DIR)
overlay=$("$config" OVERLAY_DIR)

# Source in the repository, then the path it is installed at.
links=()
# hook_link <repository>: the pre-push hook, so git runs leak-check on what it pushes.
hook_link() {
  local gitdir
  gitdir=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || { echo "not a git repository: $1"; return 1; }
  links+=("$repo/git-hooks/pre-push" "$gitdir/hooks/pre-push")
  [ -n "$(git -C "$1" config core.hooksPath)" ] && echo "core.hooksPath is set in $1, so git will not run $gitdir/hooks/pre-push."
  return 0
}
if [ $hook = 1 ]; then
  for r in "${repos[@]}"; do hook_link "$r" || exit 2; done
else
  for f in "$repo"/bin/*; do
    case "$(basename "$f")" in
      session-sweep.sh) links+=("$f" "$claude/bin/session-sweep.sh") ;;
      *) links+=("$f" "$bin/$(basename "$f")") ;;
    esac
  done
  for f in "$repo"/hooks/* "$repo"/commands/*; do
    links+=("$f" "$claude/$(basename "$(dirname "$f")")/$(basename "$f")")
  done
  for m in "$repo"/mods/*/; do
    links+=("${m%/}" "$claude/mods/$(basename "$m")")
  done
  # The engineering skills (each a folder) and their agents, for every session on this machine.
  for s in "$repo"/global-skills/*/; do
    [ -d "$s" ] && links+=("${s%/}" "$claude/skills/$(basename "$s")")
  done
  for f in "$repo"/agents/*.md; do
    [ -f "$f" ] && links+=("$f" "$claude/agents/$(basename "$f")")
  done
  [ -f "$repo/claude/git-rules.md" ] && links+=("$repo/claude/git-rules.md" "$claude/git-rules.md")
  # The pre-push hook runs leak-check in this repository, when it is a git checkout.
  if git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then hook_link "$repo"; fi
fi

short() { [[ $1 == "$HOME"/* ]] && printf '~%s' "${1#"$HOME"}" || printf '%s' "$1"; }

todo=0
for ((i = 0; i < ${#links[@]}; i += 2)); do
  src=${links[i]} dest=${links[i + 1]}
  if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then
    [ $check = 1 ] && echo "ok       $(short "$dest")"
    continue
  fi
  todo=1
  if [ -e "$dest" ] || [ -L "$dest" ]; then state=replace; else state=new; fi
  if [ $check = 1 ]; then
    echo "$([ $state = new ] && echo 'missing ' || echo 'replace ') $(short "$dest")"
    continue
  fi
  mkdir -p "$(dirname "$dest")"
  if [ $state = replace ]; then
    saved="$backup/$(short "$dest" | sed 's|^~/||; s|^/||')"
    mkdir -p "$(dirname "$saved")"
    mv "$dest" "$saved"
    echo "linked   $(short "$dest")   (old one in $(short "$saved"))"
  else
    echo "linked   $(short "$dest")"
  fi
  ln -s "$src" "$dest"
done
[ $check = 0 ] && [ $todo = 0 ] && echo "Every link is in place."
if [ $hook = 1 ]; then
  [ $check = 1 ] && exit $todo
  exit 0
fi

# settings.json: the hooks and the plugin dirs, one per mod (the overlay's mods last).
dirs=()
for m in "$repo"/mods/*/; do dirs+=("$(short "$claude/mods/$(basename "$m")")"); done
for m in "$overlay"/mods/*/; do [ -d "$m" ] && dirs+=("$(short "${m%/}")"); done
plugin_dirs=$(IFS=:; echo "${dirs[*]}")
settings="$claude/settings.json"
missing=()
want() { jq -e --arg c "$1" '[.hooks[]?[]?.hooks[]?.command] | any(. == $c)' "$settings" >/dev/null 2>&1 || missing+=("hook $1"); }
want "$(short "$claude/hooks/git-guard.sh")"
want "$(short "$claude/hooks/typecheck.sh") track"
want "$(short "$claude/hooks/typecheck.sh") gate"
have=$(jq -r '.env.CLAUDE_CODE_PLUGIN_DIRS // ""' "$settings" 2>/dev/null || true)
for d in "${dirs[@]}"; do
  case ":$have:" in *":$d:"* | *":${d/#\~/$HOME}:"*) ;; *) missing+=("plugin dir $d") ;; esac
done
if [ ${#missing[@]} -eq 0 ]; then
  echo "settings.json: hooks and plugin dirs in place."
else
  todo=1
  echo
  echo "settings.json lacks: $(IFS=,; echo "${missing[*]}" | sed 's/,/, /g')."
  echo "Merge this into $(short "$settings") by hand:"
  cat <<EOF
{
  "env": { "CLAUDE_CODE_PLUGIN_DIRS": "$plugin_dirs" },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "$(short "$claude/hooks/git-guard.sh")" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "$(short "$claude/hooks/typecheck.sh") track", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "$(short "$claude/hooks/typecheck.sh") gate", "timeout": 300 }] }
    ]
  }
}
EOF
fi
case ":$PATH:" in *":$bin:"*) ;; *) echo "$(short "$bin") is not on PATH: add it, or set BIN_DIR in the config." ;; esac
[ $check = 1 ] && exit $todo
exit 0
